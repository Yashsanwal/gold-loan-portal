# Copy to .env (never commit .env). Every value has a working default; nothing is required
# for `npm run dev` except an LLM key if you want the Loan Assist chat.

# --- API ---
PORT=4000
LOG_LEVEL=info

# --- Database ---
# Leave empty to use the embedded PGlite database (real Postgres in WASM, stored in server/.data).
# Set to use PostgreSQL, e.g. with `docker compose up db`:
# DATABASE_URL=postgres://goldloan:goldloan@localhost:5432/goldloan
DATABASE_URL=
# Run migrations and seed the two plans on startup.
AUTO_MIGRATE=true

# --- Business rules ---
# Mock 24K rate in rupees per gram, cached by GET /api/v1/gold-rate.
GOLD_RATE_24K_PER_GRAM=7000
GOLD_RATE_CACHE_SECONDS=300
DUPLICATE_WINDOW_DAYS=7
IDEMPOTENCY_TTL_HOURS=24
LEADS_RATE_LIMIT_PER_MINUTE=30
AGENT_RATE_LIMIT_PER_MINUTE=20

# --- Loan Assist (AI agent) ---
# openai | anthropic | ollama | none. Defaults to openai when OPENAI_API_KEY is set,
# then anthropic when ANTHROPIC_API_KEY is set, otherwise none (chat shows "offline").
LLM_PROVIDER=
OPENAI_API_KEY=
# gpt-6.1-terra is fast and inexpensive; gpt-6-astra is the flagship, gpt-6-luna the cheapest.
OPENAI_MODEL=gpt-6.1-terra
# none | low | medium | high | xhigh | max. low keeps chat replies fast.
OPENAI_REASONING_EFFORT=low

# Optional alternative provider: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. low keeps chat replies fast.
ANTHROPIC_EFFORT=low
# Server-side refusal fallback (beta). Set false if your gateway rejects beta headers.
ANTHROPIC_FALLBACKS=true
# Free local alternative: `ollama pull qwen2.5:7b-instruct`, then LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Tests ---
# Optional: run the test suite against a real PostgreSQL server instead of PGlite.
# TEST_DATABASE_URL=postgres://goldloan:goldloan@localhost:5432/postgres
